{
  "name": "ethmumbai",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "docs/site"
    ],
    "catalog": {
      "effect": "4.0.7",
      "@effect/platform-bun": "4.0.7",
      "@effect/platform-node": "4.0.7",
      "@effect/vitest": "4.0.7",
      "alchemy": "2.0.0-beta.84",
      "@alchemy.run/cloudflare": "2.0.0-beta.84",
      "@alchemy.run/domain": "2.0.0-beta.84",
      "@alchemy.run/frontend-frameworks": "2.0.0-beta.84",
      "foldkit": "0.169.0",
      "@foldkit/vite-plugin": "0.28.0",
      "@simplewebauthn/server": "14.0.3",
      "drizzle-orm": "1.0.0-rc.5",
      "drizzle-kit": "1.0.0-rc.5",
      "intl-messageformat": "12.1.4",
      "@formatjs/icu-messageformat-parser": "3.5.22",
      "vite": "8.3.6",
      "vitest": "5.1.0",
      "@types/bun": "1.4.4",
      "@types/node": "26.6.6",
      "viem": "2.57.16",
      "@metamask/smart-accounts-kit": "2.0.0",
      "@foldkit/ui": "0.169.0",
      "tailwindcss": "4.3.4",
      "@tailwindcss/vite": "4.3.4"
    }
  },
  "type": "module",
  "scripts": {
    "typecheck": "bun tools/typecheck.ts",
    "typecheck:reference": "tsrs --noEmit -p tsconfig.json",
    "lint": "bun tools/oxlint.ts -c oxlint.config.ts . --max-warnings 0",
    "format": "oxfmt -c oxfmt.config.ts",
    "format:check": "oxfmt -c oxfmt.config.ts --check",
    "provenance:check": "bun tools/verify-provenance.ts",
    "test": "bun run test:unit && bun run test:native",
    "test:native": "bun run build && bun run test:native:built",
    "test:unit": "vitest run --exclude **/*.native.test.ts",
    "check": "bun run format:check && bun run agents:check && bun run provenance:check && bun run vendor:check && bun run i18n:check && bun run graph:check && bun run suppressions:check && bun run canaries:check && bun run typecheck && bun run lint && bun run unused:check && bun run unused:production && bun run duplicates:check && bun run build && bun run bundle:check && bun run test:unit && bun run test:native:built",
    "i18n:check": "bun tools/i18n-check.ts",
    "i18n:generate": "bun tools/i18n-check.ts --write",
    "dev:preview": "alchemy dev --stage local",
    "build": "bun run --cwd apps/web build",
    "agents:check": "repoagents check",
    "unused:check": "knip --no-progress",
    "unused:production": "knip --production --no-progress",
    "duplicates:check": "jscpd --config .jscpd.json",
    "effect:diagnostics": "effect-tsrs diagnostics -p tsconfig.json --type-check --format json",
    "graph:check": "bun tools/graph-check.ts",
    "suppressions:check": "bun tools/suppressions-check.ts",
    "canaries:check": "bun tools/checker-canaries.ts",
    "bundle:check": "bun tools/bundle-check.ts",
    "deploy": "alchemy deploy --stage main",
    "site:deploy": "bun run --cwd docs/site deploy",
    "vendor:check": "bun tools/vendored-repos.ts",
    "test:native:built": "ALCHEMY_TEST_DEV=1 bun test packages/server/test/Runtime.native.test.ts"
  },
  "devDependencies": {
    "@0gfoundation/0g-compute-ts-sdk": "0.9.0",
    "@0gfoundation/0g-storage-ts-sdk": "1.2.13",
    "@alchemy.run/cloudflare": "catalog:",
    "@alchemy.run/domain": "catalog:",
    "@alchemy.run/frontend-frameworks": "catalog:",
    "@cloudflare/workers-types": "5.20261104.1",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/vitest": "catalog:",
    "@ethmumbai/server": "workspace:*",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@formatjs/icu-messageformat-parser": "catalog:",
    "@oxlint/plugins": "1.91.0",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@yielded/effect-tsrs": "0.2.3",
    "alchemy": "catalog:",
    "drizzle-kit": "catalog:",
    "effect": "catalog:",
    "ethers": "6.13.1",
    "jscpd": "5.4.2",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "oxc-parser": "0.157.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-plugin-complexity": "4.1.0",
    "playwright": "1.64.1",
    "repoagents": "1.1.1",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "overrides": {
    "@effect/platform-browser": "4.0.7",
    "@effect/platform-bun": "4.0.7",
    "@effect/platform-node": "4.0.7",
    "@effect/platform-node-shared": "4.0.7",
    "@effect/sql-sqlite-do": "4.0.7",
    "@effect/vitest": "4.0.7",
    "effect": "4.0.7"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@alchemy.run/domain@2.0.0-beta.84": "patches/@alchemy.run%2Fdomain@2.0.0-beta.84.patch",
    "@alchemy.run/cloudflare@2.0.0-beta.84": "patches/@alchemy.run%2Fcloudflare@2.0.0-beta.84.patch"
  },
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
